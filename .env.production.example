# RightAlly Onboarding: production settings. Copy to .env on the server and fill in.
# Stripe and Brevo keys are NOT set here: enter them in Admin > Settings (stored encrypted).
APP_NAME=RightAlly
APP_ENV=production
APP_KEY=                      # php artisan key:generate. BACK THIS UP: it decrypts saved keys and 2FA secrets.
APP_DEBUG=false
APP_URL=https://onboard.rightally.io
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

RIGHTALLY_TIMEZONE=America/New_York

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rightally_onboard
DB_USERNAME=rightally
DB_PASSWORD=                  # printed by deploy/server-setup.sh

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Only needed before Brevo is set up in Settings (fallback mailer). "log" writes emails to storage/logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@rightally.io"
MAIL_FROM_NAME="RightAlly"

# Proxies allowed to set X-Forwarded-For. Localhost by default. If Cloudflare proxies the site,
# list Cloudflare's IP ranges here (https://www.cloudflare.com/ips/), comma-separated.
TRUSTED_PROXIES=127.0.0.1,::1

# First super admin (used once by: php artisan db:seed). Remove the password afterwards.
SUPER_ADMIN_NAME="Srini"
SUPER_ADMIN_EMAIL=srini@rightally.io
SUPER_ADMIN_PASSWORD=

# Optional off-site backups via rclone (see deploy/backup.sh), e.g. b2:rightally-backups
BACKUP_RCLONE_REMOTE=
